{{- $authorName := site.Params.author | default site.Title -}}
{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- else if .IsSection -}}
  {{- $pages = .RegularPages -}}
{{- else -}}
  {{- $pages = .Pages -}}
{{- end -}}
{{- $pages = where $pages "Params.hiddenInRss" "!=" true -}}
{{- with site.Config.Services.RSS.Limit -}}
  {{- if ge . 1 }}{{- $pages = $pages | first . }}{{- end -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} | {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <copyright>{{ site.Copyright | plainify }}</copyright>
    {{- with index $pages.ByLastmod.Reverse 0 }}
    <lastBuildDate>{{ .Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages.ByPublishDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <dc:creator>{{ $authorName }}</dc:creator>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | html }}</description>
      {{- if and site.Params.ShowFullTextinRSS .Content }}
      <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
